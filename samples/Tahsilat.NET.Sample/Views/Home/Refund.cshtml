@using System.Text.Json
@model Tahsilat.NET.Models.Requests.RefundCreateRequest
@{
    ViewData["Title"] = "İade Talebi Oluşturma";
}

<div class="text-center">
    <h1 class="display-4">İade Talebi Oluşturma</h1>
    <p>İşlem numarasını girerek tam ya da kısmi iade talebi oluşturabilirsiniz.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Result != null)
        {
            var res = ViewBag.Result;
            bool ok = res.Status == true;

            <div class="alert @(ok ? "alert-success" : "alert-danger")">
                <strong>@(ok ? "İade talebi kabul edildi" : "İade talebi reddedildi")</strong>
                @if (!string.IsNullOrEmpty((string)res.Message))
                {
                    <div class="mt-1">@res.Message</div>
                }
                @if (!ok)
                {
                    <div class="mt-1">
                        <small>Banka reddettiğinde iade beklemede kalır ve tekrar denenebilir.</small>
                    </div>
                }
            </div>
            @if (ok)
            {
                <div class="alert alert-info">
                    İade endpoint'i yanıtta <code>Data</code> alanını doldurmaz. İade kaydının
                    güncel durumunu görmek için
                    <a asp-action="TransactionResult">İşlem Sonucu Sorgulama</a>
                    sayfasından aynı işlem numarasını sorgulayın.
                </div>
            }
            <details>
                <summary>Raw JSON Response</summary>
                <pre>@JsonSerializer.Serialize(ViewBag.Result, new JsonSerializerOptions { WriteIndented = true })</pre>
            </details>
        }

        <form asp-action="Refund" method="post">
            <div class="mb-3">
                <label for="transactionId" class="form-label">İşlem Numarası</label>
                <input type="number" class="form-control" id="transactionId" name="transactionId"
                       placeholder="Örn: 78810412652494">
            </div>
            <div class="mb-3">
                <label for="amount" class="form-label">Tutar <span class="text-muted">(opsiyonel)</span></label>
                <input type="number" class="form-control" id="amount" name="amount">
                <small class="text-muted">
                    Kısmi iade için kuruş cinsinden tutar girin (örn: 1000 = 10.00 TL, min 100).
                    <strong>Boş bırakırsanız işlem tutarının tamamı iade edilir.</strong>
                </small>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Açıklama</label>
                <textarea class="form-control" id="description" name="description" rows="3"
                          placeholder="En fazla 255 karakter"></textarea>
            </div>
            <button type="submit" class="btn btn-warning w-100">İade Talebi Gönder</button>
        </form>
    </div>
</div>
