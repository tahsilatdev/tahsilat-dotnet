@using System.Text.Json
@model Tahsilat.NET.Models.Requests.ProductCreateRequest
@{
    ViewData["Title"] = "Ürün Oluşturma";
}
<div class="text-center">
    <h1 class="display-4">Ürün Oluşturma</h1>
    <p>Ödeme isteklerinde kullanabileceğiniz kayıtlı ürünler oluşturun.</p>
</div>
<div class="row justify-content-center">
    <div class="col-md-6">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }
        @if (ViewBag.Result != null)
        {
            var res = ViewBag.Result;
            <div class="alert alert-success">
                <strong>Başarılı!</strong> Ürün oluşturuldu. Ürün ID: @res.Id
            </div>
            <div class="card mb-3">
                <div class="card-header bg-success text-white">Ürün Detayları</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty((string)res.ProductImageUrl))
                    {
                        <div class="text-center mb-3">
                            <img src="@res.ProductImageUrl" alt="@res.ProductName" style="max-height: 120px;" />
                        </div>
                    }
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">@res.Id</dd>

                        <dt class="col-sm-4">Ürün Adı</dt>
                        <dd class="col-sm-8">@res.ProductName</dd>

                        <dt class="col-sm-4">Fiyat</dt>
                        <dd class="col-sm-8">@res.FormattedPrice @res.CurrencyCode</dd>

                        <dt class="col-sm-4">Açıklama</dt>
                        <dd class="col-sm-8">@res.Description</dd>

                        <dt class="col-sm-4">Oluşturulma Tarihi</dt>
                        <dd class="col-sm-8">@res.FormattedCreatedAt</dd>

                        <dt class="col-sm-4">Abonelik</dt>
                        <dd class="col-sm-8">
                            @if ((bool)res.IsRecurring)
                            {
                                <span class="badge bg-primary">@res.RecurringText</span>
                                <small class="text-muted">(billing_interval=@res.BillingInterval, interval_count=@res.IntervalCount)</small>
                            }
                            else
                            {
                                <span class="text-muted">Tek seferlik ürün</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
            <details>
                <summary>Raw JSON Response</summary>
                <pre>@JsonSerializer.Serialize(ViewBag.Result, new JsonSerializerOptions { WriteIndented = true })</pre>
            </details>
        }
        <form asp-action="CreateProduct" method="post">
            <div class="mb-3">
                <label asp-for="ProductName" class="form-label">Ürün Adı</label>
                <input asp-for="ProductName" class="form-control">
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label">Fiyat</label>
                <input asp-for="Price" type="number" class="form-control">
                <small class="text-muted">Kuruş cinsinden — örn: 75900 = 759,00 TL</small>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="card mb-3">
                <div class="card-header">Abonelik (Tekrarlayan Ödeme)</div>
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input asp-for="IsRecurring" class="form-check-input" type="checkbox" value="true" id="isRecurring">
                        <label class="form-check-label" for="isRecurring">Bu ürün bir abonelik ürünü</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BillingInterval" class="form-label">Dönem</label>
                            <select asp-for="BillingInterval" class="form-select"
                                    asp-items="Html.GetEnumSelectList<Tahsilat.NET.Models.Enums.BillingInterval>()">
                                <option value="">Seçin</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="IntervalCount" class="form-label">Dönem Çarpanı</label>
                            <input asp-for="IntervalCount" type="number" min="1" max="366" class="form-control" placeholder="1">
                            <small class="text-muted">Month + 2 = iki ayda bir</small>
                        </div>
                    </div>
                    <small class="text-muted">
                        Abonelik ürünü ile <code>ProductIds</code> üzerinden başlatılan ödeme, müşteri ilk 3D ödemeyi
                        tamamladığında aboneliği otomatik oluşturur. Özellik hesabınızda etkin değilse API 4002/4007 döner.
                    </small>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100">Ürün Oluştur</button>
        </form>
    </div>
</div>