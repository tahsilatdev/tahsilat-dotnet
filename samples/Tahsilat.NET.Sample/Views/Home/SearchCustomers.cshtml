@using System.Text.Json
@using Tahsilat.NET.Models.Requests
@using Tahsilat.NET.Models.Responses
@model CustomerSearchRequest
@{
    ViewData["Title"] = "Müşteri Arama";
    var result = ViewBag.Result as CustomerSearchResponse;
}

<div class="text-center">
    <h1 class="display-4">Müşteri Arama</h1>
    <p>Filtreler AND ile birleşir; hiç filtre vermezseniz ilk sayfa gelir.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-10">
        @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

        <form asp-action="SearchCustomers" method="post" class="card card-body mb-4">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Search" class="form-label">Serbest arama</label>
                    <input asp-for="Search" class="form-control" placeholder="ad, e-posta, telefon">
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Email" class="form-label">E-posta</label>
                    <input asp-for="Email" class="form-control">
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Phone" class="form-label">Telefon</label>
                    <input asp-for="Phone" class="form-control">
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="CustomerId" class="form-label">Müşteri ID</label>
                    <input asp-for="CustomerId" type="number" class="form-control">
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="NameLastName" class="form-label">Ad Soyad</label>
                    <input asp-for="NameLastName" class="form-control">
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Başlangıç</label>
                    <input name="CustomerDate.StartDate" type="date" class="form-control" value="@Model.CustomerDate?.StartDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Bitiş</label>
                    <input name="CustomerDate.EndDate" type="date" class="form-control" value="@Model.CustomerDate?.EndDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Metadata key</label>
                    <input name="Metadata.Key" class="form-control" value="@Model.Metadata?.Key">
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Metadata value</label>
                    <input name="Metadata.Value" class="form-control" value="@Model.Metadata?.Value">
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Page" class="form-label">Sayfa</label>
                    <input asp-for="Page" type="number" class="form-control" min="1">
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Limit" class="form-label">Limit (1-100)</label>
                    <input asp-for="Limit" type="number" class="form-control" min="1" max="100">
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Ara</button>
                </div>
            </div>
        </form>

        @if (result != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span>
                    Toplam: <strong>@(result.Meta?.Total?.ToString() ?? "?")</strong>
                    @if (result.Meta?.Page != null) { <text>· Sayfa @result.Meta.Page</text> }
                    @if (result.Meta?.Limit != null) { <text>· Limit @result.Meta.Limit</text> }
                </span>
                <span class="badge bg-secondary">@(result.Customers?.Count ?? 0) satır</span>
            </div>

            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr><th>ID</th><th>Ad Soyad</th><th>E-posta</th><th>Telefon</th><th>Oluşturulma</th><th>Metadata</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var c in result.Customers ?? new())
                    {
                        <tr>
                            <td><code>@c.Id</code></td>
                            <td>@c.NameLastName</td>
                            <td>@c.Email</td>
                            <td>@c.PhoneCode @c.Phone</td>
                            <td>@c.FormattedCreatedAt</td>
                            <td class="small">@string.Join(", ", (c.Metadata ?? new()).Select(m => $"{m.Key}={m.Value}"))</td>
                            <td>
                                <form asp-action="DeleteCustomer" method="post" onsubmit="return confirm('Müşteri @c.Id silinsin mi?');">
                                    <input type="hidden" name="customerId" value="@c.Id">
                                    <button class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <details>
                <summary>Raw JSON Response (meta dahil)</summary>
                <pre>@JsonSerializer.Serialize(result, new JsonSerializerOptions { WriteIndented = true })</pre>
            </details>
        }
    </div>
</div>
